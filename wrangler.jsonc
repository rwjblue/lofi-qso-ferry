{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lofi-qso-ferry-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "ENVIRONMENT": "local",
    "RP_ID": "localhost",
    "ORIGIN": "http://localhost:8787",
    "EXPORTS_ENABLED": "false",
    "LIVE_WRITE_AUTHORIZATION": "",
    "MAIL_FROM": "LoFi QSO Ferry <ferry@example.invalid>",
    "ACTIVE_KEK_VERSION": "1",
    "ROLLOUT_CHECKS_PASSED": "false",
    "SOURCE_BOUNDARY_VERIFIED": "false",
    "QRZ_FRESH_INSERTS_ENABLED": "false",
    "LOTW_FRESH_INSERTS_ENABLED": "false",
    "ROLLOUT_QSO_IDS_JSON": "[]",
    "ROLLOUT_DESTINATION_IDS_JSON": "[]"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ferry-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "staging": {
      "name": "lofi-qso-ferry-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "RP_ID": "configure.invalid",
        "ORIGIN": "https://configure.invalid",
        "EXPORTS_ENABLED": "false",
        "LIVE_WRITE_AUTHORIZATION": "",
        "MAIL_FROM": "configure@example.invalid",
        "ACTIVE_KEK_VERSION": "1",
        "ROLLOUT_CHECKS_PASSED": "false",
        "SOURCE_BOUNDARY_VERIFIED": "false",
        "QRZ_FRESH_INSERTS_ENABLED": "false",
        "LOTW_FRESH_INSERTS_ENABLED": "false",
        "ROLLOUT_QSO_IDS_JSON": "[]",
        "ROLLOUT_DESTINATION_IDS_JSON": "[]"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ferry-staging",
          "database_id": "00000000-0000-0000-0000-000000000002",
          "migrations_dir": "migrations"
        }
      ]
    },
    "production": {
      "name": "lofi-qso-ferry",
      "vars": {
        "ENVIRONMENT": "production",
        "RP_ID": "ferry.n1rwj.com",
        "ORIGIN": "https://ferry.n1rwj.com",
        "EXPORTS_ENABLED": "false",
        "LIVE_WRITE_AUTHORIZATION": "",
        "MAIL_FROM": "LoFi QSO Ferry <signup@ferry.n1rwj.com>",
        "ACTIVE_KEK_VERSION": "1",
        "ROLLOUT_CHECKS_PASSED": "false",
        "SOURCE_BOUNDARY_VERIFIED": "false",
        "QRZ_FRESH_INSERTS_ENABLED": "false",
        "LOTW_FRESH_INSERTS_ENABLED": "false",
        "ROLLOUT_QSO_IDS_JSON": "[]",
        "ROLLOUT_DESTINATION_IDS_JSON": "[]"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ferry-production",
          "database_id": "45ad64ad-92bb-491a-b6e6-1d2b17450144",
          "migrations_dir": "migrations"
        }
      ],
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "ferry.n1rwj.com",
          "custom_domain": true
        }
      ],
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": ["signup@ferry.n1rwj.com"]
        }
      ]
    }
  },
  "account_id": "478f5e15ae2afa01364d19f42a3e06f2"
}
